<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Acción cliente que renderiza el componente OWL del tablero -->
    <record id="action_sale_dashboard" model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="tag">sale_dashboard</field>
    </record>

    <!-- Menú Dashboard: primer elemento del módulo Ventas y predeterminado.
         El menú raíz sale_menu_root no tiene acción, por lo que el primer
         hijo con acción (sequence más bajo) se abre por defecto. -->
    <menuitem id="menu_sale_dashboard"
              name="Dashboard"
              parent="sale.sale_menu_root"
              action="action_sale_dashboard"
              sequence="1"
              groups="sales_team.group_sale_salesman"/>

</odoo>
