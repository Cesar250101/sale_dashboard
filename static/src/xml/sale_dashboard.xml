<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="sale_dashboard.Dashboard" owl="1">
        <div class="o_sale_dashboard">

            <!-- Encabezado -->
            <div class="o_sd_header">
                <div class="o_sd_header_title">
                    <span class="o_sd_brand">Method</span>
                    <h1>Tablero de Ventas</h1>
                </div>
                <div class="o_sd_header_tools">
                    <select class="o_sd_period_select" t-on-change="onPeriodChange">
                        <t t-foreach="periods" t-as="p" t-key="p.value">
                            <option t-att-value="p.value" t-att-selected="p.value === state.period ? 'selected' : false">
                                <t t-esc="p.label"/>
                            </option>
                        </t>
                    </select>
                    <button class="btn o_sd_refresh" t-on-click="() => this.reload()">
                        <i class="fa fa-refresh me-1"/> Actualizar
                    </button>
                </div>
            </div>

            <t t-if="state.loading">
                <div class="o_sd_loading">
                    <i class="fa fa-circle-o-notch fa-spin fa-2x"/>
                    <span>Cargando datos…</span>
                </div>
            </t>

            <t t-else="">
                <!-- Tarjetas KPI -->
                <div class="o_sd_cards">
                    <div class="o_sd_card o_sd_card--total" t-on-click="() => this.openOrders([], 'Todas las órdenes')">
                        <div class="o_sd_card_icon"><i class="fa fa-shopping-cart"/></div>
                        <div class="o_sd_card_body">
                            <span class="o_sd_card_value" t-esc="kpis.total_orders"/>
                            <span class="o_sd_card_label">Total Órdenes</span>
                        </div>
                    </div>

                    <div class="o_sd_card" t-on-click="() => this.openOrders([['state','=','draft']], 'Cotizaciones')">
                        <div class="o_sd_card_icon o_sd_icon--draft"><i class="fa fa-file-text-o"/></div>
                        <div class="o_sd_card_body">
                            <span class="o_sd_card_value" t-esc="kpis.draft"/>
                            <span class="o_sd_card_label">Cotizaciones</span>
                        </div>
                    </div>

                    <div class="o_sd_card" t-on-click="() => this.openOrders([['state','=','sent']], 'Enviadas')">
                        <div class="o_sd_card_icon o_sd_icon--sent"><i class="fa fa-paper-plane-o"/></div>
                        <div class="o_sd_card_body">
                            <span class="o_sd_card_value" t-esc="kpis.sent"/>
                            <span class="o_sd_card_label">Enviadas</span>
                        </div>
                    </div>

                    <div class="o_sd_card" t-on-click="() => this.openOrders([['state','=','sale']], 'Órdenes de Venta')">
                        <div class="o_sd_card_icon o_sd_icon--sale"><i class="fa fa-check-circle-o"/></div>
                        <div class="o_sd_card_body">
                            <span class="o_sd_card_value" t-esc="kpis.sale"/>
                            <span class="o_sd_card_label">Confirmadas</span>
                        </div>
                    </div>

                    <div class="o_sd_card" t-on-click="() => this.openOrders([['state','=','cancel']], 'Canceladas')">
                        <div class="o_sd_card_icon o_sd_icon--cancel"><i class="fa fa-times-circle-o"/></div>
                        <div class="o_sd_card_body">
                            <span class="o_sd_card_value" t-esc="kpis.cancel"/>
                            <span class="o_sd_card_label">Canceladas</span>
                        </div>
                    </div>
                </div>

                <!-- Tarjetas de montos -->
                <div class="o_sd_amounts">
                    <div class="o_sd_amount_card o_sd_amount--primary">
                        <span class="o_sd_amount_label">Ventas Confirmadas</span>
                        <span class="o_sd_amount_value" t-esc="formatAmount(kpis.confirmed_amount)"/>
                    </div>
                    <div class="o_sd_amount_card">
                        <span class="o_sd_amount_label">Monto Total (incl. cotizaciones)</span>
                        <span class="o_sd_amount_value" t-esc="formatAmount(kpis.total_amount)"/>
                    </div>
                    <div class="o_sd_amount_card">
                        <span class="o_sd_amount_label">Ticket Promedio</span>
                        <span class="o_sd_amount_value" t-esc="formatAmount(kpis.avg_order)"/>
                    </div>
                </div>

                <!-- Gráficos -->
                <div class="o_sd_charts">
                    <div class="o_sd_chart_box">
                        <h3>Distribución por Estado</h3>
                        <div class="o_sd_chart_canvas">
                            <canvas t-ref="stateChart"/>
                        </div>
                    </div>
                    <div class="o_sd_chart_box">
                        <h3>Ventas Confirmadas por Mes (últimos 12 meses)</h3>
                        <div class="o_sd_chart_canvas">
                            <canvas t-ref="trendChart"/>
                        </div>
                    </div>
                </div>

                <!-- Top productos y top clientes -->
                <div class="o_sd_tables">
                    <div class="o_sd_chart_box">
                        <h3><i class="fa fa-cube me-2"/>Top 10 Productos Vendidos</h3>
                        <t t-if="state.data.by_product.length">
                            <table class="o_sd_table">
                                <thead>
                                    <tr><th>#</th><th>Producto</th><th class="text-end">Total</th></tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="state.data.by_product" t-as="prod" t-key="prod.id"
                                        t-on-click="() => this.openOrders([['order_line.product_id','=',prod.id],['state','in',['sale','done']]], prod.name)">
                                        <td class="o_sd_rank" t-esc="prod_index + 1"/>
                                        <td t-esc="prod.name"/>
                                        <td class="text-end o_sd_amount_cell" t-esc="formatAmount(prod.amount)"/>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                        <t t-else=""><div class="o_sd_empty">Sin datos para el periodo seleccionado.</div></t>
                    </div>

                    <div class="o_sd_chart_box">
                        <h3><i class="fa fa-users me-2"/>Top 10 Clientes</h3>
                        <t t-if="state.data.by_customer.length">
                            <table class="o_sd_table">
                                <thead>
                                    <tr><th>#</th><th>Cliente</th><th class="text-end">Total</th></tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="state.data.by_customer" t-as="cust" t-key="cust.id"
                                        t-on-click="() => this.openOrders([['partner_id','=',cust.id],['state','in',['sale','done']]], cust.name)">
                                        <td class="o_sd_rank" t-esc="cust_index + 1"/>
                                        <td t-esc="cust.name"/>
                                        <td class="text-end o_sd_amount_cell" t-esc="formatAmount(cust.amount)"/>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                        <t t-else=""><div class="o_sd_empty">Sin datos para el periodo seleccionado.</div></t>
                    </div>
                </div>
            </t>
        </div>
    </t>

</templates>
